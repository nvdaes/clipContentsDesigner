#. Translators: label of a dialog.
#: addon\installTasks.py:45
msgid "This add-on allows to confirm if you want to copy and cut, replacing the clipboard contents,\n"
"\t\twhen pressing control+c and control+x. This is named Emulate copy and cut.\n"
"\t\tDo you want to configure Emulate copy and cut now? You may do or change this later."
msgstr "Тази добавка позволява да потвърдите дали искате да копирате и изрязвате, като замените съдържанието на клипборда, \n"
"\t\tкогато натиснете Control+C и Control+X. Това се нарича емулиране на копиране и изрязване и по подразбиране работи само когато клипбордът съдържа текст. \n"
"\t\tИскате ли да конфигурирате емулирането на копиране и изрязване сега? Можете да направите или промените това по-късно."

#. Translators: title of a dialog.
#: addon\installTasks.py:49
msgid "Configure Emulate copy and cut"
msgstr "Конфигуриране на емулирането на копиране и изрязване"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:36
msgid "Preformatted text in HTML"
msgstr "Предварително форматиран текст в HTML"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:38
msgid "HTML as shown in a web browser"
msgstr "HTML, както е показано в уеб браузър"

#. Translators: Text of the clipboard shown without being formatted.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:41
msgid "Plain text"
msgstr "Обикновен текст"

#. Translators: message presented in input mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:129
msgid "Shows the Clip Contents Designer settings."
msgstr "Извежда настройките за Дизайнера на съдържанието на клипборда."

#. Translators: message presented when the clipboard content has been deleted.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:139
msgid "Clipboard cleared"
msgstr "Клипбордът е изчистен"

#. Translators: message presented when the clipboard content cannot be deleted.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:142
msgid "Clipboard not cleared"
msgstr "Клипбордът не бе изчистен"

#. Translators: Label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:229
msgid "Please, confirm if you want to add text to the clipboard"
msgstr "Моля, потвърдете дали желаете да добавите текст към клипборда"

#. Translators: Title of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:231
msgid "Adding text to clipboard"
msgstr "Добавяне на текст към клипборда"

#. Translators: message presented when the text has been added to the clipboard.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:237
#: addon\globalPlugins\clipContentsDesigner\__init__.py:246
msgid "Added"
msgstr "Добавено"

#. Translators: message presented when the text cannot be added to the clipboard.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:240
#: addon\globalPlugins\clipContentsDesigner\__init__.py:249
msgid "Cannot add"
msgstr "Не може да се добави"

#. Translators: message presented in input mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:254
msgid "Retrieves the selected string or the text from the previously set start marker up to and including the current position of the review cursor, and adds it to the clipboard."
msgstr "Извлича избрания низ или текст от предварително зададения начален маркер до и включително текущата позиция на курсора за преглед и го добавя в клипборда."

#. Translators: Label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:270
msgid "Please, confirm if you want to clear the clipboard"
msgstr "Моля, потвърдете дали желаете да изчистите клипборда"

#. Translators: Title of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:272
msgid "Clearing clipboard"
msgstr "Изчистване на клипборда"

#. Translators: message presented in input mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:281
msgid "Deletes the added text and the content of the clipboard."
msgstr "Изтрива добавения текст и съдържанието на клипборда."

#. Translators: Label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:309
msgid "Please, confirm if you want to copy to the clipboard"
msgstr "Моля, потвърдете дали желаете да копирате в клипборда"

#. Translators: Title of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:311
msgid "Copying to clipboard"
msgstr "Копиране в клипборда"

#. Translators: message presented in input mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:321
msgid "Copies to the clipboard, with the possibility of being asked for a previous confirmation"
msgstr "Копира в клипборда с възможност за запитване за потвърждение преди извършване на операцията"

#. Translators: Label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:339
msgid "Please, confirm if you want to cut from the clipboard"
msgstr "Моля, потвърдете дали желаете да изрежете от клипборда"

#. Translators: Title of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:341
msgid "Cutting from clipboard"
msgstr "Изрязване от клипборда"

#. Translators: message presented in input mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:351
msgid "Cuts from the clipboard, with the possibility of being asked for a previous confirmation"
msgstr "Изрязва от клипборда с възможност за запитване за потвърждение преди извършване на операцията"

#. Translators: message presented in input mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:362
msgid "Shows the clipboard text as HTML in browse mode"
msgstr "Показва текста на клипборда като HTML в режим на разглеждане"

#. Translators: presented when clipboard is not empty, but there is no text to show in browse mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:372
#: addon\globalPlugins\clipContentsDesigner\__init__.py:413
msgid "Clipboard is not empty, but there is no text to show"
msgstr "Клипбордът не е празен, но няма текст за показване"

#. Translators: presented when clipboard is empty.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:375
#: addon\globalPlugins\clipContentsDesigner\__init__.py:416
msgid "Clipboard is empty"
msgstr "Клипбордът е празен"

#. Translators: title of a browseable message.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:391
#: addon\globalPlugins\clipContentsDesigner\__init__.py:427
#, python-brace-format
msgid "Clipboard text ({max}/{current} - {formatForTitle})"
msgstr "Текст в клипборда ({max}/{current} – {formatForTitle})"

#. Translators: message presented in input mode.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:403
msgid "Shows the clipboard textual contents as plain text in browse mode"
msgstr "Показва текста на клипборда като обикновен текст в режим на разглеждане"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:445
msgid "Type the string to be used as a &separator between contents added to the clipboard."
msgstr "Въведете низа, който ще се използва като &разделител между отделните части на добавеното в клипборда съдържание."

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:450
msgid "&Add text before clip data"
msgstr "&Добави текста преди данните в клипборда"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:453
msgid "Sele&ct the actions which require previous confirmation"
msgstr "Из&берете действията, които изискват предварително потвърждение"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:456
msgid "Confirm to add text"
msgstr "Потвърждение за добавяне на текст"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:458
msgid "Confirm to clear clipboard"
msgstr "Потвърждение за изчистване на клипборда"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:460
msgid "Confirm to emulate copy"
msgstr "Потвърждение за емулиране на копирането"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:462
msgid "Confirm to emulate cut"
msgstr "Потвърждение за емулиране на изрязването"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:481
msgid "&Request confirmation before performing the selected actions when:"
msgstr "&Запитване преди извършването на избраните действия, когато:"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:484
msgid "Always"
msgstr "Винаги"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:486
msgid "If the clipboard contains text"
msgstr "Ако клипбордът съдържа текст"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:488
msgid "If the clipboard is not empty"
msgstr "Ако клипбордът не е празен"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:499
msgid "&Format to show the clipboard text as HTML in browse mode:"
msgstr "&Формат, в който да се извежда текстът на клипборда като HTML в режим на разглеждане:"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:503
msgid "&Maximum number of characters when showing clipboard text in browse mode"
msgstr "&Максимален брой символи при извеждане на текста от клипборда в режим на разглеждане"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:513
msgid "Show configuration dialog when &updating"
msgstr "Показвай диалоговия прозорец с настройките при &обновяване"

#. Translators: label of a dialog.
#: addon\globalPlugins\clipContentsDesigner\__init__.py:517
msgid "Restore defaults"
msgstr "Възстанови настройките по подразбиране"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "Clip Contents Designer"
msgstr "Дизайнер на съдържанието на клипборда (Clip Contents Designer)"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Allows the joining of separate fragments of text on the clipboard and clearing of clipboard content. Current text on the clipboard can be presented in browse mode. Option to request confirmation before performing actions such as copy, cut, add text, or clearing the clipboard to avoid accidental changes."
msgstr "Позволява обединяването на отделни фрагменти от текст в клипборда и изчистване на съдържанието на клипборда. Текущият текст в клипборда може да бъде представен в режим на разглеждане. Опция за искане на потвърждение преди извършване на действия като копиране, изрязване, добавяне на текст или изчистване на клипборда, за да се избегнат случайни промени."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:28
msgid "* Restored ability to check the clipboard content."
msgstr ""

